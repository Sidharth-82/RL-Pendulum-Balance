# --- build output ------------------------------------------------------------
# The presets build out-of-tree at %LOCALAPPDATA%/pidrl-build, so these catch an
# accidental in-source configure rather than the normal path.
build/
out/
.cache/
install/
compile_commands.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
_deps/
.ninja_deps
.ninja_log
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.exe
*.dll

# Per-developer preset overrides (local LibTorch path, etc.)
CMakeUserPresets.json

# MSVC / VSCode
*.user
.vs/

# VSCode: extensions.json and settings.json are deliberate project config -- the
# CMake Tools / IntelliSense wiring documented in CMakePresets.json depends on
# them, so they are tracked. Everything else in .vscode/ is per-machine, and
# c_cpp_properties.json in particular is regenerated by cpptools.
.vscode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.vscode/c_cpp_properties.json
.vscode/ipch/

# Machine-local agent settings.
.claude/settings.local.json

# --- training artifacts ------------------------------------------------------
# rl/src/main.cpp writes the checkpoint, the per-iteration log and one trajectory
# dump per evaluation into the working directory.
checkpoints/
runs/
logs/
*.pt
*.onnx
policy.pt
train_log.csv
trajectory_*.csv

# --- test reports ------------------------------------------------------------
# physics_validation and energy_conservation write HTML next to their binary, so
# these only appear if the tests are run by hand with an explicit path.
physics_validation.html
energy_conservation.html

# Throwaway drivers (e.g. the LQR envelope report) that are not repo targets yet.
scratchpad/

# --- notes and reference material --------------------------------------------
# Personal scratch notes; the durable content lives in README.md.
remember.md

# ACIN / TU Wien reference footage, (c) CDS 2011 -- 6.6 MB of third-party video
# that does not belong in git history. README.md links the source instead.
Triple Pendulum on a Cart.mp4

# --- OS / OneDrive noise -----------------------------------------------------
# This checkout lives inside OneDrive, which writes desktop.ini into folders it
# has decorated.
desktop.ini
Thumbs.db
ehthumbs.db
*.stackdump
~$*
